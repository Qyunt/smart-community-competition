<?xml version="1.0"?>
<sdf version="1.6">
  <world name="sq_community_4p2_skeleton">
    <include><uri>model://sun</uri></include>
    <gravity>0 0 -9.8</gravity>
    <!-- Physical arena: x/y from -2.1 to +2.1 m. No guessed buildings or lanes. -->
    <model name="arena_floor_4p2">
      <static>true</static>
      <link name="floor">
        <pose>0 0 -0.01 0 0 0</pose>
        <collision name="floor_collision">
          <geometry><box><size>4.2 4.2 0.02</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>4.2 4.2 0.02</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Geometric marker only: known 0.6 m start area in the upper right. -->
    <model name="start_region_0p6">
      <static>true</static>
      <link name="marker">
        <pose>1.8 1.8 0.002 0 0 0</pose>
        <visual name="start_visual">
          <geometry><box><size>0.6 0.6 0.002</size></box></geometry>
          <material><ambient>0.12 0.45 0.16 1</ambient><diffuse>0.12 0.45 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
