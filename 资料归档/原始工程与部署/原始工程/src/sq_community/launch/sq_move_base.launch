<launch>
  <!-- ============================================================
       sq_move_base.launch —— move_base（本包自带参数，不依赖 turtlebot3 库存）

       与 turtlebot3_navigation/launch/move_base.launch 的区别：
         只把 5 个 rosparam 文件来源换成 $(find sq_community)/param/sq_*.yaml，
         其余结构与 remap 完全一致 —— 便于和库存配置做 A/B 对照。

       为什么要自带一套参数：库存参数是为开阔室内环境标定的
       （inflation_radius 1.0 m / conservative_reset_dist 3.0 m），
       在 10.0×7.2 m、街道净宽约 1.1 m 的本场地里会频繁触发
       DWA 规划失败与"卡住恢复"。改的理由逐条写在各个 sq_*.yaml 里。
       ============================================================ -->

  <arg name="model"           default="$(optenv TURTLEBOT3_MODEL waffle)"/>
  <arg name="cmd_vel_topic"   default="/cmd_vel"/>
  <arg name="odom_topic"      default="odom"/>
  <arg name="move_forward_only" default="false"/>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>

    <!-- 公共参数（障碍源 / 轮廓 / 膨胀）要分别装进两个 costmap 命名空间 -->
    <rosparam file="$(find sq_community)/param/sq_costmap_common.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find sq_community)/param/sq_costmap_common.yaml" command="load" ns="local_costmap"/>

    <rosparam file="$(find sq_community)/param/sq_global_costmap.yaml" command="load"/>
    <rosparam file="$(find sq_community)/param/sq_local_costmap.yaml"  command="load"/>
    <rosparam file="$(find sq_community)/param/sq_move_base.yaml"      command="load"/>
    <rosparam file="$(find sq_community)/param/sq_dwa.yaml"            command="load"/>

    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom"    to="$(arg odom_topic)"/>

    <param name="DWAPlannerROS/min_vel_x" value="0.0" if="$(arg move_forward_only)"/>
  </node>
</launch>
