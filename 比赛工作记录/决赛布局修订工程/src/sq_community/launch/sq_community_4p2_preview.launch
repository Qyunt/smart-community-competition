<launch>
  <!-- Preview the current competition layout, using the same robot and world. -->
  <arg name="gui" default="true"/>
  <arg name="spawn_robot" default="false"/>
  <include file="$(find sq_community)/launch/sq_community_4p2.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="spawn_robot" value="$(arg spawn_robot)"/>
  </include>
</launch>